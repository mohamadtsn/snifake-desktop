{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sni-fake",
  "version": "../package.json",
  "identifier": "com.snifake.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && cargo build --release -p sni-fake-engine",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SNI Spoof",
        "width": 420,
        "height": 560,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/sni-fake-engine": "sni-fake-engine",
      "scripts/install-sudoers.sh": "install-sudoers.sh"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/com.snifake.desktop.policy": "policy/com.snifake.desktop.policy"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/polkit-1/actions/com.snifake.desktop.policy": "policy/com.snifake.desktop.policy"
        }
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}