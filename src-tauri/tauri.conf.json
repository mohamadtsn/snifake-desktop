{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snifake",
  "mainBinaryName": "snifake",
  "version": "../package.json",
  "identifier": "io.github.mohamadtsn.snifake",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && sh src-tauri/scripts/build-engine.sh",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snifake",
        "width": 420,
        "height": 504,
        "minWidth": 380,
        "minHeight": 440,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/*": "./",
      "scripts/install-sudoers.sh": "install-sudoers.sh"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/io.github.mohamadtsn.snifake.policy": "policy/io.github.mohamadtsn.snifake.policy"
        },
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "pkexec | policykit-1"
        ]
      },
      "rpm": {
        "files": {
          "/usr/share/polkit-1/actions/io.github.mohamadtsn.snifake.policy": "policy/io.github.mohamadtsn.snifake.policy"
        },
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "polkit"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "publisher": "Mohamad Tsn",
    "homepage": "https://github.com/mohamadtsn/snifake-desktop",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Mohamad Tsn",
    "category": "Utility",
    "shortDescription": "TLS SNI-spoofing proxy",
    "longDescription": "Snifake runs a local TLS SNI-spoofing forwarder. It configures, launches with elevated privileges, monitors and stops the bundled snifake-engine, and keeps connection profiles you can switch between.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mohamadtsn/snifake-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQjM2NzAxNTcyRjVEODUKUldTRlhTOVhBV2V6bkJsNTV5aGhnbTJ1N0xPOTZiTzdOeE1RRkJNUU9YUG5nV2JhOFZ5UUpqV2MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
