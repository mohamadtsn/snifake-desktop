# Development Dockerfile — tools for building & testing
FROM python:3.12-slim

# System deps for PySide6 / Qt + dev tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libegl1 \
    libglib2.0-0 \
    libfontconfig1 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libx11-xcb1 \
    libdbus-1-3 \
    git \
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir \
    -r requirements.txt \
    pyinstaller \
    ruff

# Default: interactive shell
CMD ["/bin/bash"]
